{
  "name": "pixel-calendar-2027",
  "version": "0.12.2",
  "private": true,
  "description": "Пиксельный календарь 2027: веб-версия и Android-приложение на Capacitor.",
  "scripts": {
    "build:web": "node tools/build-web.js",
    "check": "node tools/check-js.js",
    "verify": "node tools/check-js.js && node --test \"tests/**/*.test.js\" && node tools/build-web.js",
    "sync": "node sync-server/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "android:add": "npm run build:web && cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:patch": "node tools/patch-android.js"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_task_bg_night"
    android:paddingStart="6dp"
    android:paddingTop="5dp"
    android:paddingEnd="7dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/widget_task_mark"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/tiny5"
        android:gravity="center"
        android:text="□"
        android:textColor="#A9D89A"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_task_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#F1E4C8"
        android:textSize="12sp" />
</LinearLayout>
